{
  "name": "Apple Hide My Email",
  "short_name": "Apple HME",
  "description": "Independent open-source extension for Apple's Hide My Email service. Not affiliated with Apple. Use at your own risk.",
  "author": "Axvant UG (haftungsbeschränkt)",
  "homepage_url": "https://axvant.com/",
  "manifest_version": 3,
  "background": { "service_worker": "background.bundle.js" },
  "action": {
    "default_popup": "popup.html",
    "default_icon": "icon-32.png"
  },
  "declarative_net_request": {
    "rule_resources": [
      {
        "id": "icloud_com_simulation_headers",
        "enabled": true,
        "path": "rules.json"
      }
    ]
  },
  "permissions": [
    "activeTab",
    "scripting",
    "declarativeNetRequest",
    "storage",
    "contextMenus",
    "webRequest",
    "notifications"
  ],
  "host_permissions": ["https://*.icloud.com/*", "https://*.icloud.com.cn/*"],
  "icons": {
    "16": "icon-16.png",
    "32": "icon-32.png",
    "48": "icon-48.png",
    "128": "icon-128.png"
  }
}
